# Copy to .env (not committed) and set your own passwords.

# superuser of the development Postgres container (docker-compose.dev.yml)
POSTGRES_USER=admin
POSTGRES_PASSWORD=

# password of the non-superuser role popgres_app (scripts/ci-db-setup.sql)
APP_PASSWORD=

# main database of "go run ./examples/base serve"
# DATABASE_URL=postgres://admin:<postgres-password>@localhost:5433/popgres?sslmode=disable

# template database of the tests
# POPGRES_TEST_URL=postgres://popgres_app:<app-password>@localhost:5433/popgres_test?sslmode=disable
